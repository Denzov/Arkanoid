while(1){
        Mat frame, hsv_frame, ball_mask, concatenation_mask, up_mask, low_mask, eroded_mask;
        float average_x = 0, average_y = 0;
        
        static float prev_average_x = 0;
        static float prev_average_y = 0;
        
        static std::clock_t last_time = 0;

        float sum_x = 0, sum_y = 0;
        uint32_t pixel_mask = 0;

        float speed_ball_x = 0;
        float speed_ball_y = 0;
        float dt = 0;

        cap_m >> frame;
        
        cvtColor(frame, hsv_frame, COLOR_BGR2HSV);
        inRange(hsv_frame, lower_hsv_down, lower_hsv_up, low_mask);
        inRange(hsv_frame, upper_hsv_down, upper_hsv_up, up_mask);

        concatenation_mask = up_mask | low_mask;

        erode(concatenation_mask, ball_mask, kernel);

        for (uint16_t y = 0; y < ball_mask.rows; y++)
        {
            for (uint16_t x = 0; x < ball_mask.cols; x++)
            {   
                uint8_t cur_pixel = ball_mask.at<uint8_t>(y, x);
                if(cur_pixel == 255){
                    sum_x += x;
                    sum_y += y;
                    pixel_mask++;
                }                
            }
        }

        average_x = sum_x / pixel_mask;
        average_y = sum_y / pixel_mask;

        //std::cout << "x: " << average_x * K_to_sm << " y: " << average_y * K_to_sm  << '\n';
        
        dt = static_cast<float>(std::clock() - last_time) * 0.01;
        last_time = std::clock();

        speed_ball_x = (average_x - prev_average_x) / dt;
        speed_ball_y = (average_y - prev_average_y) / dt;

        line(frame, 
            Point(static_cast<int>(average_x), static_cast<int>(average_y)), 
            Point(static_cast<int>(average_x + speed_ball_x), static_cast<int>(average_y + speed_ball_y)),
            Scalar(0, 255, 0), 2);

        prev_average_x = average_x;
        prev_average_y = average_y;

        imshow("ball", ball_mask);
        imshow("default", frame);

        if(waitKey(1) == 'q'){
            break;
        }
    }